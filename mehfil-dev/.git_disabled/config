[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/LuckyRathee/mehfil-app
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "Development"]
	remote = origin
	merge = refs/heads/Development
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "lucky-dev"]
	vscode-merge-base = origin/Development
